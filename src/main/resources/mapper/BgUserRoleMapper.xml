<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xc.blogbackend.mapper.BgUserRoleMapper">

    <resultMap id="BaseResultMap" type="com.xc.blogbackend.model.domain.entity.BgUserRole">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="roleId" column="role_id" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,role_id
    </sql>

    <select id="getUserRole" resultType="com.xc.blogbackend.model.domain.vo.RoleVo">
        select ur.user_id,r.id as role_id,r.code,r.name  from bg_user_role ur
            left join bg_role r on ur.role_id = r.id
        where ur.user_id = #{userId} and r.is_delete = 0
    </select>
</mapper>
